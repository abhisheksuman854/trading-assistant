# TradeLens AI - Environment Configuration
# Copy this file to .env and fill in your Angel One SmartAPI credentials

# Angel One SmartAPI (Free at https://smartapi.angelbroking.com)
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_password_or_mpin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Backend Port & Network Binding (Home Mac keeps all secrets locally)
PORT=8000
TRADELENS_BIND_HOST=127.0.0.1

# Remote Private-Network Mode (Tailscale only; keep DISABLED until Stage B host provisioning)
# Restrict repository root `.env` permissions with `chmod 600 .env` before enabling remote mode.
# Set TRADELENS_REMOTE_ACCESS_ENABLED=1 ONLY when binding private Tailscale IP with HTTPS TLS + HMAC state
# TRADELENS_REMOTE_ACCESS_ENABLED=0
# TRADELENS_ALLOWED_VPN_CIDRS=100.64.0.0/10
# TRADELENS_ALLOWED_PEER_IPS=100.x.y.office_ip
# TRADELENS_ALLOWED_HOSTS=100.x.y.home_ip,home-mac.your-tailnet.ts.net
# TRADELENS_ALLOWED_ORIGINS=https://100.x.y.home_ip:8080,https://home-mac.your-tailnet.ts.net:8080
# TRADELENS_TLS_CERT_FILE=/Users/you/.tradelens/certs/home-mac.crt
# TRADELENS_TLS_KEY_FILE=/Users/you/.tradelens/certs/home-mac.key
# TRADELENS_STATE_HMAC_SECRET=generate_min_32_byte_random_hex_hmac_secret
# Optional local loopback admin port when bound to Tailscale IP (defaults to 8001 on 127.0.0.1 only; set 0 to disable)
# TRADELENS_LOCAL_ADMIN_PORT=8001
# Do NOT store plaintext TRADELENS_OWNER_SECRET in .env if initialized interactively via:
#   python3.12 -m backend.app.runtime.cli init-owner --owner-secret-prompt --remote-access


